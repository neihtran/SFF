# ============================================================
# SFF Backend — Environment Variables (TEMPLATE)
# Copy file này thành .env và điền giá trị thật.
# .env KHÔNG được commit; file này để chia sẻ cấu trúc biến.
# ============================================================

# --- Database (Supabase) ---
DATABASE_URL=
DIRECT_URL=

# --- JWT ---
JWT_SECRET=
JWT_REFRESH_SECRET=

# --- Google Gemini API ---
GEMINI_API_KEY=

# --- Supabase Storage ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- LiveKit ---
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Frontend (CORS) ---
FRONTEND_URL=http://localhost:5173
