# ============================================================
# SFF (Say For Fun) — Root .gitignore
# Áp dụng cho cả backend/ frontend/ mobile/ docs/
# KHÔNG commit: node_modules, dist, build, .env, log
# ============================================================

# Dependencies
**/node_modules/
**/node_modules
**/package-lock.json.bak

# Build outputs
**/dist/
**/build/
**/out/
**/.next/
**/.svelte-kit/
**/.turbo/
**/.cache/

# Environments (BẮT BUỘC giữ bí mật)
**/.env
**/.env.local
**/.env.development
**/.env.production
**/.env.test
**/.env.*.local
!**/.env.example
!**/.env.sample

# Logs
**/*.log
**/logs/
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*
**/lerna-debug.log*

# IDE / Editor
**/.idea/
**/.vscode/
!**/.vscode/settings.json
!**/.vscode/extensions.json
**/.DS_Store
**/Thumbs.db
**/*.swp
**/*.swo

# Testing & Coverage
**/coverage/
**/.nyc_output/
**/.jest/

# Prisma generated client
**/node_modules/.prisma/
**/node_modules/@prisma/client/

# Misc
**/.tmp/
**/.temp/
**/.sass-cache/
**/.eslintcache
**/.tsbuildinfo
**/*.tsbuildinfo

# Mobile (Expo) — sinh ra ở Tuần 6, giữ chỗ để chuẩn bị sẵn
**/.expo/
**/.expo-shared/
**/expo-env.d.ts
**/web-build/
**/android/
**/ios/

# OS
**/.DS_Store
**/.AppleDouble
**/.LSOverride
**/Icon?
**/.Spotlight-V100
**/.Trashes
**/ehthumbs.db
**/ehthumbs_vista.db

# Temporary files
**/*~
**/*.tmp
**/*.bak
**/*.backup
